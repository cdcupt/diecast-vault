    "share.body.alt": {
      "comment": "Share prompt body when a canonical scan exists.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A canonical scan of this release + drive already exists, so there’s no pressure. If yours came out cleaner, you can offer it as an alternate."
