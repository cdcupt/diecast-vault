    "scan.invite.bond.cta": {
      "comment": "Bond CTA on the invite screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bond a car I own"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定我拥有的车"
          }
        }
      }
    },
    "scan.invite.bond.note": {
      "comment": "Note above the bond affordance on the invite screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can still add cars you own — bond a copy to a community scan when one exists."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你仍可添加自己拥有的车——当社区已有扫描时，把你的实物绑定上去。"
          }
        }
      }
    },
    "scan.invite.eyebrow": {
      "comment": "Lightbar eyebrow on the capability-invite screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contribute a scan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贡献扫描"
          }
        }
      }
    },
    "scan.invite.heroCaption": {
      "comment": "Mono caption under the invite hero glyph.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A niche waiting to be lit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一格等待点亮的展位"
          }
        }
      }
    },
    "scan.invite.pitch.body": {
      "comment": "Invite contributor-pitch body.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every scan a Pro owner shares saves everyone else from re-scanning the same release. When you’re on a Pro iPhone, you can light niches no one else has."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每位 Pro 用户分享的扫描，都能让其他人无需重复扫描同一款车。当你使用 Pro 版 iPhone 时，便能点亮无人涉足的展位。"
          }
        }
      }
    },
    "scan.invite.pitch.title": {
      "comment": "Invite contributor-pitch title.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’d be seeding the library"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将为社区库播下第一颗种子"
          }
        }
      }
    },
    "scan.invite.requirement.body %@ %@": {
      "comment": "Invite requirement body. %1$@ lower Pro device, %2$@ upper Pro device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guided capture and on-device reconstruction use LiDAR + photogrammetry, available on a Pro iPhone (%1$@ through %2$@). The simulator can’t run a camera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引导拍摄与设备端重建需要 LiDAR 与摄影测量，仅 Pro 版 iPhone（%1$@ 至 %2$@）支持。模拟器无法使用相机。"
          }
        }
      }
    },
    "scan.invite.requirement.title": {
      "comment": "Invite requirement row title.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why this device can’t scan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为何此设备无法扫描"
          }
        }
      }
    },
    "scan.invite.title": {
      "comment": "Capability-invite headline (unsupported device).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning new cars needs a Pro iPhone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描新车需要 Pro 版 iPhone"
          }
        }
      }
    },
    "scan.recon.body %lld": {
      "comment": "Reconstruction body. %lld is frame count.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meshing %lld frames into a reduced-detail USDZ. This runs entirely on your iPhone — nothing leaves the device yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在把 %lld 帧合成为简化精度的 USDZ。全程在你的 iPhone 上完成——目前没有任何数据离开设备。"
          }
        }
      }
    },
    "scan.recon.label": {
      "comment": "Reconstruction progress label.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstructing on-device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在设备端重建"
          }
        }
      }
    },
    "scan.step %lld %lld": {
      "comment": "Step chip in the guided flow, e.g. 'Step 1 / 4'. First %lld is current, second is total.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %1$lld / %2$lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$lld / %2$lld 步"
          }
        }
      }
    },
    "scan.tip.cta": {
      "comment": "Tip screen CTA.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start capture orbit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始环绕拍摄"
          }
        }
      }
    },
    "scan.tip.lightingBody": {
      "comment": "Tip lighting well body.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft, diffuse light from several sides. Glossy diecast loves to reflect — kill the hotspots."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采用来自多个方向的柔和散射光。光亮的合金车容易反光——消除高光点。"
          }
        }
      }
    },
    "scan.tip.lightingTitle": {
      "comment": "Tip lighting well title.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lighting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光照"
          }
        }
      }
    },
    "scan.tip.removeBody": {
      "comment": "Tip card body.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear acrylic confuses photogrammetry. Place the loose car on a matte, evenly-lit surface — no harsh window light."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "透明亚克力会干扰摄影测量。把车单独放在哑光、光照均匀的台面上——避开刺眼的窗光。"
          }
        }
      }
    },
    "scan.tip.removeTitle": {
      "comment": "Tip card title.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take it out of the case"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把它从展示盒中取出"
          }
        }
      }
    },
    "scan.tip.title": {
      "comment": "Tip screen headline.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you scan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描之前"
          }
        }
      }
    },
    "scan.title": {
      "comment": "Scan flow nav title.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a car"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描车模"
          }
        }
      }
    },
    "scan.verdict.captured": {
      "comment": "Verdict capture summary.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body & livery captured well. Spin it below to judge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "车身与涂装捕捉良好。在下方旋转查看以做判断。"
          }
        }
      }
    },
    "scan.verdict.caveat.body": {
      "comment": "Verdict reduced-detail caveat body.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thin spoilers and clear windows came out soft — normal for small glossy diecast. Fine for showing off; re-scan if you want the canonical community model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纤细的尾翼与透明车窗略显模糊——这是小尺寸光亮合金车的常态。用于展示足矣；若想要社区标准模型，可重新扫描。"
          }
        }
      }
    },
    "scan.verdict.caveat.title": {
      "comment": "Verdict reduced-detail caveat title.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduced detail"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精度有所简化"
          }
        }
      }
    },
    "scan.verdict.complete": {
      "comment": "Verdict status chip.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan complete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描完成"
          }
        }
      }
