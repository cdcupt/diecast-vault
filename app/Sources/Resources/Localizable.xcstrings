{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "bond.cta": {
      "comment": "Bond save CTA.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stamp & bond"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刻印并绑定"
          }
        }
      }
    },
    "bond.cta.hint": {
      "comment": "Bond CTA accessibility hint.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves this model to your collection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把该模型保存到你的收藏。"
          }
        }
      }
    },
    "bond.eyebrow": {
      "comment": "Bond lightbar eyebrow.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add to your cabinet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入你的陈列柜"
          }
        }
      }
    },
    "bond.field.drive": {
      "comment": "Bond field label: drive (required, half the key).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive — required"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "驾驶位——必选"
          }
        }
      }
    },
    "bond.field.edition": {
      "comment": "Bond field label: optional edition serial.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edition serial — optional (per copy)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限量编号——可选（每件独立）"
          }
        }
      }
    },
    "bond.field.edition.note": {
      "comment": "Bond edition field note.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stamped on your copy only — not shared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅记录在你的这件藏品上——不会共享。"
          }
        }
      }
    },
    "bond.field.number": {
      "comment": "Bond field label: Mini GT number.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini GT number"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini GT 编号"
          }
        }
      }
    },
    "bond.heading": {
      "comment": "Bond screen headline.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a car you own"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加你拥有的车模"
          }
        }
      }
    },
    "bond.matched %@": {
      "comment": "Bond number match confirmation chip. %@ is the car name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "matched · %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已匹配 · %@"
          }
        }
      }
    },
    "bond.subhead": {
      "comment": "Bond subhead on the dev/invite path (no live scan).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach the catalog identity to a copy you own."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为你拥有的实物附上目录身份。"
          }
        }
      }
    },
    "bond.subhead.scan": {
      "comment": "Bond subhead when bonding a fresh scan.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach the catalog identity. The scan is already saved — bonding just gives it a name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为其附上目录身份。扫描已保存——绑定只是给它取个名字。"
          }
        }
      }
    },
    "bond.title": {
      "comment": "Bond screen nav title.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a car"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加车模"
          }
        }
      }
    },
    "addcar.title": {
      "comment": "Add-a-car sheet title + Cabinet toolbar accessibility label.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a car"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加车模"
          }
        }
      }
    },
    "cabinet.lightbar": {
      "comment": "Cabinet section lightbar eyebrow (rendered uppercase)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Cabinet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "陈列柜"
          }
        }
      }
    },
    "cabinet.litCount.full %lld %lld": {
      "comment": "Lightbar header count for the 3D cabinet home: lit-of-total. First %lld is lit niches, second is the total shelf size.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld lit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已点亮 %1$lld / 共 %2$lld"
          }
        }
      }
    },
    "cabinet.style.chip": {
      "comment": "Mono STYLE chip on the cabinet lightbar header that opens the style picker.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Style"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }
      }
    },
    "cabinet.style.default": {
      "comment": "Badge marking the default cabinet style in the picker.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认"
          }
        }
      }
    },
    "cabinet.style.garage.name": {
      "comment": "Cabinet style name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Garage / Pit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "车库 / 维修区"
          }
        }
      }
    },
    "cabinet.style.garage.tagline": {
      "comment": "Cabinet style tagline (mono).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lived-in workshop energy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "充满使用感的工坊气息"
          }
        }
      }
    },
    "cabinet.style.lightbarWhite.name": {
      "comment": "Cabinet style name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightbar White"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "亮柜白"
          }
        }
      }
    },
    "cabinet.style.lightbarWhite.tagline": {
      "comment": "Cabinet style tagline (mono).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bright showroom vitrine"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明亮展厅陈列柜"
          }
        }
      }
    },
    "cabinet.style.museum.name": {
      "comment": "Cabinet style name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Museum Vitrine"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "博物馆展柜"
          }
        }
      }
    },
    "cabinet.style.museum.tagline": {
      "comment": "Cabinet style tagline (mono). Notes this is the one dark, contained case.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dark, contained case — like the 3D stage"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深色独立展柜——如同 3D 舞台"
          }
        }
      }
    },
    "cabinet.style.picker.blurb": {
      "comment": "Subtitle in the style picker — styles are cosmetic only.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same shelves, dressed differently. Pick a look — your collection is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同样的陈列架，不同的外观。换个样式即可——你的收藏不受影响。"
          }
        }
      }
    },
    "cabinet.style.picker.done": {
      "comment": "Done button that closes the style picker sheet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "cabinet.style.picker.title": {
      "comment": "Title of the 'Choose your cabinet' style picker sheet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your cabinet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择陈列柜外观"
          }
        }
      }
    },
    "cabinet.style.walnut.name": {
      "comment": "Cabinet style name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walnut Case"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "胡桃木柜"
          }
        }
      }
    },
    "cabinet.style.walnut.tagline": {
      "comment": "Cabinet style tagline (mono).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm collector's study"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温润藏家书房"
          }
        }
      }
    },
    "catalog.chooseDrive": {
      "comment": "Label above the LHD/RHD drive toggle (rendered uppercase)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose drive"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择驾驶位"
          }
        }
      }
    },
    "catalog.continuePrompt": {
      "comment": "Disabled CTA prompting the user to pick a drive first",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a drive to continue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择驾驶位以继续"
          }
        }
      }
    },
    "catalog.continueWith %@": {
      "comment": "Continue CTA once a drive is chosen. %@ is the drive code (LHD/RHD).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue with %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 %@ 继续"
          }
        }
      }
    },
    "catalog.empty.blurb": {
      "comment": "No-match helper text",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try the catalog number or the livery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试用目录编号或涂装名称搜索。"
          }
        }
      }
    },
    "catalog.empty.title %@": {
      "comment": "No-match heading. %@ is the search query.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No match for “%@”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到“%@”"
          }
        }
      }
    },
    "catalog.search.prompt": {
      "comment": "Catalog search field placeholder",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Number, name, or livery"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编号、名称或涂装"
          }
        }
      }
    },
    "detail.cta.onShelf": {
      "comment": "Already-owned state of the pick button",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your shelf"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在陈列柜"
          }
        }
      }
    },
    "detail.cta.pick": {
      "comment": "Add this release to your shelf",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick to shelf"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收入陈列柜"
          }
        }
      }
    },
    "detail.cta.view3D": {
      "comment": "Open the dark-stage 3D viewer",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View in 3D"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 3D"
          }
        }
      }
    },
    "detail.face.model": {
      "comment": "Detail segmented control — the diecast model face",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型"
          }
        }
      }
    },
    "detail.face.realCar": {
      "comment": "Detail segmented control — the full-size real-car face",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real Car"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真车"
          }
        }
      }
    },
    "detail.invite.basicNote": {
      "comment": "Contribution invite note on a non-Pro device",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This release doesn't have a 3D model in the library yet. You can still add it to your shelf."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这款车在库中还没有 3D 模型。你仍可以把它加入你的陈列柜。"
          }
        }
      }
    },
    "detail.invite.basicTitle": {
      "comment": "Contribution invite title on a non-Pro device",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No 3D model yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无 3D 模型"
          }
        }
      }
    },
    "detail.tag.community": {
      "comment": "Ownership tag — community model, not yet owned (rendered uppercase)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Community"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "社区"
          }
        }
      }
    },
    "detail.tag.yours": {
      "comment": "Ownership tag — you own a model (rendered uppercase)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yours"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的"
          }
        }
      }
    },
    "language.displayLanguage": {
      "comment": "Section heading on the Language screen (rendered uppercase)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display language"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示语言"
          }
        }
      }
    },
    "language.liveNote": {
      "comment": "Note that switching applies live across the whole app",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching applies live across the whole app — no relaunch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换语言会即时刷新整个界面，无需重启应用。"
          }
        }
      }
    },
    "language.selected": {
      "comment": "Badge marking the currently active language",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选"
          }
        }
      }
    },
    "language.whatLocalizes.body": {
      "comment": "Explainer body — car model names stay as proper nouns",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UI strings, tabs and the real-car history all switch. Car model names stay as proper nouns (e.g. Porsche 911 GT3 RS)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面文字、标签页与真车车史都会切换。车款名称保留为专有名词（如 Porsche 911 GT3 RS）。"
          }
        }
      }
    },
    "language.whatLocalizes.title": {
      "comment": "Heading for the 'what localizes' explainer",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What localizes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪些内容会本地化"
          }
        }
      }
    },
    "me.footer": {
      "comment": "App version + legal footnote",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diecast Vault · v1.0 · catalog numbers are descriptive metadata only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diecast Vault · v1.0 · 目录编号仅为描述性元数据。"
          }
        }
      }
    },
    "me.row.cabinetStyle": {
      "comment": "Me/Settings row that opens the cabinet style picker.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabinet style"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "陈列柜外观"
          }
        }
      }
    },
    "me.row.language": {
      "comment": "Settings row title — language; also the Language screen title",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言"
          }
        }
      }
    },
    "me.settings.heading": {
      "comment": "Settings section heading (rendered uppercase)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "me.signedIn": {
      "comment": "Subtitle under the username",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local collection — no account needed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地收藏——无需账户"
          }
        }
      }
    },
    "realcar.attribution.ai": {
      "comment": "Caption under an AI illustration",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI illustration — not a real photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 插画 — 并非真实照片"
          }
        }
      }
    },
    "realcar.attribution.photo %@ %@": {
      "comment": "Photo attribution line. %1$@ is the photographer, %2$@ is the license.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo: %1$@ · %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片：%1$@ · %2$@"
          }
        }
