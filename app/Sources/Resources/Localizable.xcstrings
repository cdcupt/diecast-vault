{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "bond.cta": {
      "comment": "Bond save CTA.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stamp & bond"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刻印并绑定"
          }
        }
      }
    },
    "bond.cta.hint": {
      "comment": "Bond CTA accessibility hint.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves this model to your collection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把该模型保存到你的收藏。"
          }
        }
      }
    },
    "bond.eyebrow": {
      "comment": "Bond lightbar eyebrow.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bond the model"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定该模型"
          }
        }
      }
    },
    "bond.field.drive": {
      "comment": "Bond field label: drive (required, half the key).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive — required (half the key)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "驾驶位——必选（构成识别键的一半）"
          }
        }
      }
    },
    "bond.field.edition": {
      "comment": "Bond field label: optional edition serial.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edition serial — optional (per copy)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限量编号——可选（每件独立）"
          }
        }
      }
    },
    "bond.field.edition.note": {
      "comment": "Bond edition field note.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stamped on this copy only — never part of the shared dedup key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅印于此件之上——绝不参与共享去重键。"
          }
        }
      }
    },
    "bond.field.number": {
      "comment": "Bond field label: Mini GT number.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini GT number"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini GT 编号"
          }
        }
      }
    },
    "bond.heading": {
      "comment": "Bond screen headline.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bond the model"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定该模型"
          }
        }
      }
    },
    "bond.matched %@": {
      "comment": "Bond number match confirmation chip. %@ is the car name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "matched · %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已匹配 · %@"
          }
        }
      }
    },
    "bond.subhead.dev": {
      "comment": "Bond subhead on the dev/invite path (no live scan).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach the catalog identity to a copy you own. Bonding never needs the camera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为你拥有的实物附上目录身份。绑定无需使用相机。"
          }
        }
      }
    },
    "bond.subhead.scan": {
      "comment": "Bond subhead when bonding a fresh scan.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach the catalog identity. The scan is already saved — bonding just gives it a name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为其附上目录身份。扫描已保存——绑定只是给它取个名字。"
          }
        }
      }
    },
    "bond.title": {
      "comment": "Bond screen nav title.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bond"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定"
          }
        }
      }
    },
    "cabinet.empty.blurb": {
      "comment": "Empty cabinet helper text",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a release from the Catalog to light its first niche."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从目录中挑选一款车，点亮它的第一格展位。"
          }
        }
      }
    },
    "cabinet.empty.title": {
      "comment": "Empty cabinet heading",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cabinet is dark"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的陈列柜还未点亮"
          }
        }
      }
    },
    "cabinet.lightbar": {
      "comment": "Cabinet section lightbar eyebrow (rendered uppercase)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Cabinet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "陈列柜"
          }
        }
      }
    },
    "cabinet.litCount %lld": {
      "comment": "Lit-of-total count next to the big serif number, e.g. '/ 12 lit'. %lld is the total shelf size.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "/ %lld lit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "/ 共 %lld 件点亮"
          }
        }
      }
    },
    "cabinet.litCount.full %lld %lld": {
      "comment": "Lightbar header count for the 3D cabinet home: lit-of-total. First %lld is lit niches, second is the total shelf size.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld lit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已点亮 %1$lld / 共 %2$lld"
          }
        }
      }
    },
    "cabinet.style.chip": {
      "comment": "Mono STYLE chip on the cabinet lightbar header that opens the style picker.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Style"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }
      }
    },
    "cabinet.style.default": {
      "comment": "Badge marking the default cabinet style in the picker.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认"
          }
        }
      }
    },
    "cabinet.style.garage.name": {
      "comment": "Cabinet style name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Garage / Pit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "车库 / 维修区"
          }
        }
      }
    },
    "cabinet.style.garage.tagline": {
      "comment": "Cabinet style tagline (mono).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lived-in workshop energy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "充满使用感的工坊气息"
          }
        }
      }
    },
    "cabinet.style.lightbarWhite.name": {
      "comment": "Cabinet style name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightbar White"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "亮柜白"
          }
        }
      }
    },
    "cabinet.style.lightbarWhite.tagline": {
      "comment": "Cabinet style tagline (mono).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bright showroom vitrine"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明亮展厅陈列柜"
          }
        }
      }
    },
    "cabinet.style.museum.name": {
      "comment": "Cabinet style name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Museum Vitrine"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "博物馆展柜"
          }
        }
      }
    },
    "cabinet.style.museum.tagline": {
      "comment": "Cabinet style tagline (mono). Notes this is the one dark, contained case.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dark, contained case — like the 3D stage"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深色独立展柜——如同 3D 舞台"
          }
        }
      }
    },
    "cabinet.style.picker.blurb": {
      "comment": "Subtitle in the style picker — styles are cosmetic only.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same shelves, dressed differently. Pick a look — your collection is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同样的陈列架，不同的外观。换个样式即可——你的收藏不受影响。"
          }
        }
      }
    },
    "cabinet.style.picker.done": {
      "comment": "Done button that closes the style picker sheet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "cabinet.style.picker.title": {
      "comment": "Title of the 'Choose your cabinet' style picker sheet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your cabinet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择陈列柜外观"
          }
        }
      }
    },
    "cabinet.style.walnut.name": {
      "comment": "Cabinet style name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walnut Case"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "胡桃木柜"
          }
        }
      }
    },
    "cabinet.style.walnut.tagline": {
      "comment": "Cabinet style tagline (mono).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm collector's study"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温润藏家书房"
          }
        }
      }
    },
    "catalog.chooseDrive": {
      "comment": "Label above the LHD/RHD drive toggle (rendered uppercase)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose drive"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择驾驶位"
          }
        }
      }
    },
    "catalog.continuePrompt": {
      "comment": "Disabled CTA prompting the user to pick a drive first",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a drive to continue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择驾驶位以继续"
          }
        }
      }
    },
    "catalog.continueWith %@": {
      "comment": "Continue CTA once a drive is chosen. %@ is the drive code (LHD/RHD).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue with %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 %@ 继续"
          }
        }
      }
    },
    "catalog.empty.blurb": {
      "comment": "No-match helper text",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try the catalog number or the livery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试用目录编号或涂装名称搜索。"
          }
        }
      }
    },
    "catalog.empty.title %@": {
      "comment": "No-match heading. %@ is the search query.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No match for “%@”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到“%@”"
          }
        }
      }
    },
    "catalog.search.prompt": {
      "comment": "Catalog search field placeholder",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Number, name, or livery"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编号、名称或涂装"
          }
        }
      }
    },
    "detail.cta.onShelf": {
      "comment": "Already-owned state of the pick button",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your shelf"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在陈列柜"
          }
        }
      }
    },
    "detail.cta.pick": {
      "comment": "Add this release to your shelf",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick to shelf"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收入陈列柜"
          }
        }
      }
    },
    "detail.cta.view3D": {
      "comment": "Open the dark-stage 3D viewer",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View in 3D"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 3D"
          }
        }
      }
    },
    "detail.face.model": {
      "comment": "Detail segmented control — the diecast model face",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型"
          }
        }
      }
    },
    "detail.face.realCar": {
      "comment": "Detail segmented control — the full-size real-car face",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real Car"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真车"
          }
        }
      }
    },
    "detail.invite.basicNote": {
      "comment": "Contribution invite note on a non-Pro device",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No community scan yet — needs a Pro iPhone to seed it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "社区尚无扫描 — 需要一台 Pro 机型的 iPhone 来发起。"
          }
        }
      }
    },
    "detail.invite.basicTitle": {
      "comment": "Contribution invite title on a non-Pro device",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No community scan yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "社区尚无扫描"
          }
        }
      }
    },
    "detail.invite.proNote": {
      "comment": "Contribution invite note on a Pro device",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first to light this for the community."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成为第一个为社区点亮它的人。"
          }
        }
      }
    },
    "detail.invite.proTitle": {
      "comment": "Contribution invite title on a Pro device (no scan yet)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first to light this"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成为第一个点亮它的人"
          }
        }
      }
    },
    "detail.tag.community": {
      "comment": "Ownership tag — community model, not yet owned (rendered uppercase)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Community"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "社区"
          }
        }
      }
    },
    "detail.tag.yours": {
      "comment": "Ownership tag — you own a model (rendered uppercase)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yours"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的"
          }
        }
      }
    },
    "language.displayLanguage": {
      "comment": "Section heading on the Language screen (rendered uppercase)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display language"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示语言"
          }
        }
      }
    },
    "language.liveNote": {
      "comment": "Note that switching applies live across the whole app",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching applies live across the whole app — no relaunch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换语言会即时刷新整个界面，无需重启应用。"
          }
        }
      }
    },
    "language.selected": {
      "comment": "Badge marking the currently active language",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选"
          }
        }
      }
    },
    "language.whatLocalizes.body": {
      "comment": "Explainer body — car model names stay as proper nouns",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UI strings, tabs and the real-car history all switch. Car model names stay as proper nouns (e.g. Porsche 911 GT3 RS). Traditional Chinese comes later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面文字、标签页与真车车史都会切换。车款名称保留为专有名词（如 Porsche 911 GT3 RS）。繁體中文稍后推出。"
          }
        }
      }
    },
    "language.whatLocalizes.title": {
      "comment": "Heading for the 'what localizes' explainer",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What localizes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪些内容会本地化"
          }
        }
      }
    },
    "library.blurb": {
      "comment": "Library placeholder blurb",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reuse scans the community has shared, and contribute your own. Browse and upload arrive once the backend lands."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复用社区共享的扫描模型，也可贡献你自己的。浏览与上传将在后端上线后开放。"
          }
        }
      }
    },
    "me.contribution.heading": {
      "comment": "Contribution summary section heading (rendered uppercase)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your contribution"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的贡献"
          }
        }
      }
    },
    "me.contribution.litReleases": {
      "comment": "Sits after the big '9' — releases lit for the community",
