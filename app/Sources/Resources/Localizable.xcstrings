    "scan.tip.removeBody": {
      "comment": "Tip card body.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear acrylic confuses photogrammetry. Place the loose car on a matte, evenly-lit surface — no harsh window light."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "透明亚克力会干扰摄影测量。把车单独放在哑光、光照均匀的台面上——避开刺眼的窗光。"
          }
