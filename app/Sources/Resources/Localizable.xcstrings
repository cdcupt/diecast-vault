    "scan.invite.pitch.body": {
      "comment": "Invite contributor-pitch body.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every scan a Pro owner shares saves everyone else from re-scanning the same release. When guided scanning arrives, you can light niches no one else has."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每位 Pro 用户分享的扫描，都能让其他人无需重复扫描同一款车。引导扫描上线后，你便能点亮无人涉足的展位。"
          }
        }
      }
    },
    "scan.invite.pitch.title": {
      "comment": "Invite contributor-pitch title.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll be seeding the library"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将为社区库播下第一颗种子"
          }
        }
      }
    },
    "scan.invite.requirement.body %@ %@": {
      "comment": "Invite requirement body. %1$@ lower Pro device, %2$@ upper Pro device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guided capture and on-device reconstruction use LiDAR + photogrammetry on a Pro iPhone (%1$@ through %2$@). We’re validating scan quality on real diecast cars before switching it on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引导拍摄与设备端重建基于 LiDAR 与摄影测量，需要 Pro 版 iPhone（%1$@ 至 %2$@）。我们正在实体车模上验证扫描质量，随后开放。"
          }
        }
      }
    },
    "scan.invite.requirement.title": {
      "comment": "Invite requirement row title.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built for Pro iPhones"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 Pro 版 iPhone 打造"
          }
        }
      }
    },
    "scan.invite.title": {
